+void S3MultiPartUpload::AbortMultipartUpload() {
+	string query_param = "uploadId=" + S3FileSystem::UrlEncode(multipart_upload_id, true);
+	auto res = s3fs.DeleteRequest(*http_input, path, {}, query_param);
+	if (res->status != HTTPStatusCode::OK_200 && res->status != HTTPStatusCode::NoContent_204) {
+		throw HTTPException(*res, "Unexpected response during S3 multipart upload abort: %d\n\n%s",
+		                    static_cast<int>(res->status), res->GetError());
+	}
+}
