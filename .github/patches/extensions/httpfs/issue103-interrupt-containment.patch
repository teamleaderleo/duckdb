+
+TEST_CASE("HTTPFS contains S3 multipart publication during interrupted teardown", "[httpfs][s3][upload][interrupt]") {
+	SECTION("interrupted handle destruction does not wait for or complete a blocked upload") {
+		RunInterruptedHandleDestructionScenario();
+	}
+	SECTION("interrupted COPY does not complete multipart upload") {
+		RunInterruptedMultipartCopyScenario();
+	}
+	SECTION("successful implicit destruction still completes multipart upload") {
+		RunImplicitMultipartCloseSuccessScenario();
+	}
+}
 
