+	RequireQueryOk(con, "SET s3_uploader_thread_limit=1");
+}
+
+static void RunInterruptedHandleDestructionScenario() {
+	MockS3ServerConfig config;
+	config.bucket = BUCKET;
+	config.object_key = OBJECT_KEY;
+	config.stale_key_id = STALE_KEY_ID;
+	config.refresh_target = MockS3RefreshTarget::DELETE_OBJECT;
+	config.block_first_multipart_part_until_released = true;
+	MockS3Server server(std::move(config));
+
+	DuckDB db(nullptr);
+	Connection con(db);
+	ConfigureMultipartContainmentTest(db, con, server);
+
+	auto &fs = FileSystem::GetFileSystem(*con.context);
+	ClientContextFileOpener opener(*con.context);
+	auto handle = fs.OpenFile(S3_PATH, FileFlags::FILE_FLAGS_WRITE | FileFlags::FILE_FLAGS_FILE_CREATE_NEW, &opener);
+	string payload(6 * 1024 * 1024, 'x');
+	handle->Write(QueryContext(*con.context), &payload[0], payload.size());
+	REQUIRE(server.WaitForMultipartPart());
+
+	con.Interrupt();
+	std::promise<void> destroyed;
+	auto destroyed_future = destroyed.get_future();
+	auto raw_handle = handle.release();
+	std::thread destroy_thread([raw_handle, &destroyed]() {
+		unique_ptr<FileHandle> owned_handle(raw_handle);
+		owned_handle.reset();
+		destroyed.set_value();
+	});
+
+	auto returned_before_release =
+	    destroyed_future.wait_for(std::chrono::seconds(1)) == std::future_status::ready;
+	server.ReleaseMultipartPart();
+	destroy_thread.join();
+	con.context->ClearInterrupt();
+
+	REQUIRE(returned_before_release);
+	REQUIRE(WaitForObservationTarget(server, "PUT", 200, "partNumber"));
+	auto observations = server.Observations();
+	INFO(MockS3DescribeObservations(observations));
+	REQUIRE(CountObservationsTarget(observations, "POST", 200, "uploadId") == 0);
+}
+
+static void RunInterruptedMultipartCopyScenario() {
+	MockS3ServerConfig config;
+	config.bucket = BUCKET;
+	config.object_key = OBJECT_KEY;
+	config.stale_key_id = STALE_KEY_ID;
+	config.refresh_target = MockS3RefreshTarget::DELETE_OBJECT;
+	config.block_first_multipart_part_until_released = true;
+	MockS3Server server(std::move(config));
+
+	DuckDB db(nullptr);
+	Connection con(db);
+	ConfigureMultipartContainmentTest(db, con, server);
+
+	unique_ptr<QueryResult> query_result;
+	std::thread query_thread([&]() {
+		query_result = con.Query(R"(
+COPY (
+	SELECT i::BIGINT AS i, repeat('x', 128) AS payload
+	FROM range(100000000) t(i)
+) TO 's3://refresh-bucket/object.bin' (FORMAT CSV)
+)");
+	});
+
+	REQUIRE(server.WaitForMultipartPart());
+	con.Interrupt();
+	server.ReleaseMultipartPart();
+	query_thread.join();
+
+	REQUIRE(query_result);
+	REQUIRE(query_result->HasError());
+	REQUIRE(query_result->GetError().find("Interrupt") != string::npos);
+	RequireQueryOk(con, "SELECT 103");
+	REQUIRE(WaitForObservationTarget(server, "PUT", 200, "partNumber"));
+	auto observations = server.Observations();
+	INFO(MockS3DescribeObservations(observations));
+	REQUIRE(CountObservationsTarget(observations, "POST", 200, "uploadId") == 0);
+}
+
+static void RunImplicitMultipartCloseSuccessScenario() {
+	MockS3ServerConfig config;
+	config.bucket = BUCKET;
+	config.object_key = OBJECT_KEY;
+	config.stale_key_id = STALE_KEY_ID;
+	config.refresh_target = MockS3RefreshTarget::DELETE_OBJECT;
+	MockS3Server server(std::move(config));
+
+	DuckDB db(nullptr);
+	Connection con(db);
+	ConfigureMultipartContainmentTest(db, con, server);
+
+	auto &fs = FileSystem::GetFileSystem(*con.context);
+	ClientContextFileOpener opener(*con.context);
+	auto handle = fs.OpenFile(S3_PATH, FileFlags::FILE_FLAGS_WRITE | FileFlags::FILE_FLAGS_FILE_CREATE_NEW, &opener);
+	string payload(10 * 1024 * 1024 + 1, 's');
+	handle->Write(QueryContext(*con.context), &payload[0], payload.size());
+	handle.reset();
+
+	auto observations = server.Observations();
+	INFO(MockS3DescribeObservations(observations));
+	REQUIRE(CountObservationsTarget(observations, "PUT", 200, "partNumber") > 0);
+	REQUIRE(CountObservationsTarget(observations, "POST", 200, "uploadId") == 1);
+}
 
