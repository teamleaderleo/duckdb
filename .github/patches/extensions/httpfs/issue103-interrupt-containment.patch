+static void ConfigureMultipartContainmentTest(DuckDB &db, Connection &con, MockS3Server &server) {
+	ConfigureRefreshTest(db, con, server, "httplib", false, false);
+	RequireQueryOk(con, "SET threads=1");
+	RequireQueryOk(con, "SET s3_uploader_max_filesize='100MB'");
