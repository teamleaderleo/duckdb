+static bool WaitForObservationTarget(MockS3Server &server, const string &method, int status,
+	                                 const string &target_contains) {
+	auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+	do {
+		if (CountObservationsTarget(server.Observations(), method, status, target_contains) > 0) {
+			return true;
+		}
+		std::this_thread::sleep_for(std::chrono::milliseconds(10));
+	} while (std::chrono::steady_clock::now() < deadline);
+	return false;
+}
