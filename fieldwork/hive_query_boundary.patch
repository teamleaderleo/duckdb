+static bool HasURIScheme(const string &filename) {
+	auto scheme_end = filename.find("://");
+	if (scheme_end == string::npos || scheme_end <= 1) {
+		// A one-character prefix can be a Windows drive letter.
+		return false;
+	}
+	if (!((filename[0] >= 'a' && filename[0] <= 'z') || (filename[0] >= 'A' && filename[0] <= 'Z'))) {
+		return false;
+	}
+	for (idx_t i = 1; i < scheme_end; i++) {
+		auto c = filename[i];
+		if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '+' ||
+		      c == '-' || c == '.')) {
+			return false;
+		}
+	}
+	return true;
+}
