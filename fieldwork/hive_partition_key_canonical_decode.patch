 #include "duckdb/common/uhugeint.hpp"
 #include "duckdb/execution/expression_executor.hpp"
 #include "duckdb/planner/expression/bound_columnref_expression.hpp"
@@ -92,6 +93,21 @@ bool HivePartitioning::IsNull(const string &input) {
 	return StringUtil::CIEquals(input, "NULL") || input == "__HIVE_DEFAULT_PARTITION__";
 }
 
+static string UnescapeKey(const string &key) {
+	try {
+		auto unescaped_key = HivePartitioning::Unescape(key);
+		// Only decode canonical output from HivePartitioning::Escape. This restores
+		// writer-produced identifiers without reinterpreting non-canonical external
+		// spellings such as "%61" or invalid UTF-8 percent sequences.
+		if (HivePartitioning::Escape(unescaped_key) == key) {
+			return unescaped_key;
+		}
+	} catch (const InvalidInputException &) {
+		// Preserve external path keys that are not valid encoded UTF-8.
+	}
+	return key;
+}
+
 // matches hive partitions in file name. For example:
 // 	- s3://bucket/var1=value1/bla/bla/var2=value2
 //  - http(s)://domain(:port)/lala/kasdl/var1=value1/?not-a-var=not-a-value
@@ -111,6 +127,7 @@ std::map<string, string> HivePartitioning::Parse(const string &filename) {
 			if (candidate_partition && equality_sign > partition_start) {
 				// we found a partition with an equality sign
 				string key = filename.substr(partition_start, equality_sign - partition_start);
+				key = UnescapeKey(key);
 				string value = filename.substr(equality_sign + 1, c - equality_sign - 1);
 				result.insert(make_pair(std::move(key), std::move(value)));
 			}
