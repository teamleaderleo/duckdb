# name: test/sql/copy/partitioned/hive_partition_key_roundtrip.test
# description: Round-trip URL-escaped Hive partition column names
# group: [partitioned]

require parquet

statement ok
CREATE TABLE escaped_key_roundtrip(
    "=/ \\/" VARCHAR,
    id INTEGER
);

statement ok
INSERT INTO escaped_key_roundtrip VALUES
    ('alpha', 1),
    ('beta', 2),
    ('alpha', 3);

statement ok
COPY escaped_key_roundtrip TO '{TEST_DIR}/escaped-key-roundtrip'
(FORMAT PARQUET, PARTITION_BY ("=/ \\/"), OVERWRITE);

# The writer emits the URL-escaped key, but readers should expose the original identifier.
query II
SELECT "=/ \\/", count(*)
FROM parquet_scan('{TEST_DIR}/escaped-key-roundtrip/**/*.parquet', hive_partitioning=1)
GROUP BY ALL
ORDER BY ALL
----
alpha	2
beta	1

# Filters resolved from path constants should use the decoded identifier as well.
query I
SELECT id
FROM parquet_scan('{TEST_DIR}/escaped-key-roundtrip/**/*.parquet', hive_partitioning=1)
WHERE "=/ \\/" = 'beta';
----
2

# Decode exactly once: a literal percent spelling in a key stays a percent spelling.
statement ok
CREATE TABLE percent_key_roundtrip(
    "%2F" VARCHAR,
    id INTEGER
);

statement ok
INSERT INTO percent_key_roundtrip VALUES ('value', 10);

statement ok
COPY percent_key_roundtrip TO '{TEST_DIR}/percent-key-roundtrip'
(FORMAT PARQUET, PARTITION_BY ("%2F"), OVERWRITE);

query II
SELECT "%2F", id
FROM parquet_scan('{TEST_DIR}/percent-key-roundtrip/**/*.parquet', hive_partitioning=1);
----
value	10

# Multiple escaped keys must retain their original names and nesting.
statement ok
CREATE TABLE nested_escaped_keys(
    "a=b" VARCHAR,
    "x/y" VARCHAR,
    id INTEGER
);

statement ok
INSERT INTO nested_escaped_keys VALUES
    ('left', 'up', 20),
    ('left', 'down', 21),
    ('right', 'up', 22);

statement ok
COPY nested_escaped_keys TO '{TEST_DIR}/nested-escaped-keys'
(FORMAT PARQUET, PARTITION_BY ("a=b", "x/y"), OVERWRITE);

query III
SELECT "a=b", "x/y", id
FROM parquet_scan('{TEST_DIR}/nested-escaped-keys/**/*.parquet', hive_partitioning=1)
ORDER BY id
----
left	up	20
left	down	21
right	up	22
