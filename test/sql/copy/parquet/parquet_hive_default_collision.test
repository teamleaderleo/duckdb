# name: test/sql/copy/parquet/parquet_hive_default_collision.test
# description: Preserve SQL NULL and the literal Hive default-partition marker as distinct partition values
# group: [parquet]

require parquet

# Minimal overwrite collision: both logical values must survive and remain distinct.
statement ok
CREATE TABLE hive_default_partition_collision AS
SELECT * FROM (VALUES ('__HIVE_DEFAULT_PARTITION__', 1), (NULL, 2)) v(p, id);

statement ok
COPY hive_default_partition_collision TO '{TEST_DIR}/hive-default-partition-collision'
(FORMAT PARQUET, PARTITION_BY (p), OVERWRITE);

query III
SELECT (p IS NULL)::INTEGER AS is_null, p, id
FROM parquet_scan('{TEST_DIR}/hive-default-partition-collision/**/*.parquet', hive_partitioning=1)
ORDER BY id
----
0	__HIVE_DEFAULT_PARTITION__	1
1	NULL	2

# Path-derived filter constants must preserve the same distinction before file open.
query I
SELECT id
FROM parquet_scan('{TEST_DIR}/hive-default-partition-collision/**/*.parquet', hive_partitioning=1)
WHERE p = '__HIVE_DEFAULT_PARTITION__';
----
1

query I
SELECT id
FROM parquet_scan('{TEST_DIR}/hive-default-partition-collision/**/*.parquet', hive_partitioning=1)
WHERE p IS NULL;
----
2

query I
SELECT count(*)
FROM glob('{TEST_DIR}/hive-default-partition-collision/p=__HIVE_DEFAULT_PARTITION__/*.parquet');
----
1

query I
SELECT count(*)
FROM glob('{TEST_DIR}/hive-default-partition-collision/p=%5F_HIVE_DEFAULT_PARTITION__/*.parquet');
----
1

query I
SELECT count(DISTINCT filename)
FROM parquet_scan('{TEST_DIR}/hive-default-partition-collision/**/*.parquet', filename=1);
----
2

# UUID filenames prevent overwrite but must not collapse the literal to SQL NULL.
statement ok
CREATE TABLE hive_default_partition_uuid AS
SELECT * FROM (VALUES ('__HIVE_DEFAULT_PARTITION__', 10), (NULL, 20)) v(p, id);

statement ok
COPY hive_default_partition_uuid TO '{TEST_DIR}/hive-default-partition-uuid'
(FORMAT PARQUET, PARTITION_BY (p), OVERWRITE, FILENAME_PATTERN 'part_{uuid}');

query III
SELECT (p IS NULL)::INTEGER AS is_null, p, id
FROM parquet_scan('{TEST_DIR}/hive-default-partition-uuid/**/*.parquet', hive_partitioning=1)
ORDER BY id
----
0	__HIVE_DEFAULT_PARTITION__	10
1	NULL	20

query I
SELECT count(*)
FROM glob('{TEST_DIR}/hive-default-partition-uuid/p=__HIVE_DEFAULT_PARTITION__/part_*.parquet');
----
1

query I
SELECT count(*)
FROM glob('{TEST_DIR}/hive-default-partition-uuid/p=%5F_HIVE_DEFAULT_PARTITION__/part_*.parquet');
----
1

# The selected encoded token must remain distinct from a literal string that spells that token.
statement ok
CREATE TABLE hive_default_partition_escape_alias AS
SELECT * FROM (VALUES
    ('__HIVE_DEFAULT_PARTITION__', 30),
    ('%5F_HIVE_DEFAULT_PARTITION__', 40),
    (NULL, 50)
) v(p, id);

statement ok
COPY hive_default_partition_escape_alias TO '{TEST_DIR}/hive-default-partition-escape-alias'
(FORMAT PARQUET, PARTITION_BY (p), OVERWRITE);

query III
SELECT (p IS NULL)::INTEGER AS is_null, p, id
FROM parquet_scan('{TEST_DIR}/hive-default-partition-escape-alias/**/*.parquet', hive_partitioning=1)
ORDER BY id
----
0	__HIVE_DEFAULT_PARTITION__	30
0	%5F_HIVE_DEFAULT_PARTITION__	40
1	NULL	50

query I
SELECT id
FROM parquet_scan('{TEST_DIR}/hive-default-partition-escape-alias/**/*.parquet', hive_partitioning=1)
WHERE p = '%5F_HIVE_DEFAULT_PARTITION__';
----
40

query I
SELECT count(*)
FROM glob('{TEST_DIR}/hive-default-partition-escape-alias/p=__HIVE_DEFAULT_PARTITION__/*.parquet');
----
1

query I
SELECT count(*)
FROM glob('{TEST_DIR}/hive-default-partition-escape-alias/p=%5F_HIVE_DEFAULT_PARTITION__/*.parquet');
----
1

query I
SELECT count(*)
FROM glob('{TEST_DIR}/hive-default-partition-escape-alias/p=%255F_HIVE_DEFAULT_PARTITION__/*.parquet');
----
1

# Nested multi-column partitions keep the reserved marker distinct at every parent path.
statement ok
CREATE TABLE hive_default_partition_nested AS
SELECT * FROM (VALUES
    ('north', '__HIVE_DEFAULT_PARTITION__', 100),
    ('north', NULL, 200),
    ('south', '__HIVE_DEFAULT_PARTITION__', 300),
    ('south', NULL, 400)
) v(region, p, id);

statement ok
COPY hive_default_partition_nested TO '{TEST_DIR}/hive-default-partition-nested'
(FORMAT PARQUET, PARTITION_BY (region, p), OVERWRITE, FILENAME_PATTERN 'part_{uuid}');

query IIII
SELECT region, (p IS NULL)::INTEGER AS is_null, p, id
FROM parquet_scan('{TEST_DIR}/hive-default-partition-nested/**/*.parquet', hive_partitioning=1)
ORDER BY id
----
north	0	__HIVE_DEFAULT_PARTITION__	100
north	1	NULL	200
south	0	__HIVE_DEFAULT_PARTITION__	300
south	1	NULL	400

query I
SELECT count(*)
FROM glob('{TEST_DIR}/hive-default-partition-nested/region=north/p=__HIVE_DEFAULT_PARTITION__/part_*.parquet');
----
1

query I
SELECT count(*)
FROM glob('{TEST_DIR}/hive-default-partition-nested/region=north/p=%5F_HIVE_DEFAULT_PARTITION__/part_*.parquet');
----
1

query I
SELECT count(*)
FROM glob('{TEST_DIR}/hive-default-partition-nested/region=south/p=__HIVE_DEFAULT_PARTITION__/part_*.parquet');
----
1

query I
SELECT count(*)
FROM glob('{TEST_DIR}/hive-default-partition-nested/region=south/p=%5F_HIVE_DEFAULT_PARTITION__/part_*.parquet');
----
1

# Existing raw Hive markers remain the SQL NULL representation.
statement ok
COPY (SELECT NULL::VARCHAR AS p, 3 AS id)
TO '{TEST_DIR}/hive-default-partition-existing'
(FORMAT PARQUET, PARTITION_BY (p), OVERWRITE);

query I
SELECT count(*)
FROM glob('{TEST_DIR}/hive-default-partition-existing/p=__HIVE_DEFAULT_PARTITION__/*.parquet');
----
1

query II
SELECT (p IS NULL)::INTEGER AS is_null, id
FROM parquet_scan('{TEST_DIR}/hive-default-partition-existing/**/*.parquet', hive_partitioning=1)
----
1	3
